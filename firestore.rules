rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        (request.auth.token.email == "kushalmmahajan@gmail.com" && request.auth.token.email_verified == true)
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      // Validation helper for User entity
      function isValidUser(data) {
        return data.email is string && 
               data.email.size() > 0 &&
               data.role in ['student', 'admin'] &&
               (data.keys().hasAll(['name']) ? (data.name is string && data.name.size() <= 100) : true);
      }

      allow create: if isOwner(userId) && 
                    isValidUser(request.resource.data) &&
                    request.resource.data.role == 'student';
      
      allow update: if isAdmin() || (
        isOwner(userId) && 
        isValidUser(request.resource.data) &&
        request.resource.data.role == resource.data.role && // Cannot change role
        request.resource.data.email == resource.data.email // Cannot change email
      );
      
      allow delete: if isAdmin();
    }

    match /elections/{electionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /candidates/{candidateId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voteCount']) &&
        request.resource.data.voteCount == resource.data.voteCount + 1 &&
        !exists(/databases/$(database)/documents/voter_receipts/$(request.auth.uid + '_' + resource.data.electionId)) &&
        getAfter(/databases/$(database)/documents/voter_receipts/$(request.auth.uid + '_' + resource.data.electionId)) != null
      );
    }

    match /voter_receipts/{receiptId} {
      allow read: if isAdmin() || (isAuthenticated() && receiptId.matches('^' + request.auth.uid + '_.*'));
      allow create: if isAuthenticated() &&
        receiptId == request.auth.uid + '_' + request.resource.data.electionId &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasAll(['electionId', 'userId', 'timestamp']);
      allow update, delete: if false; // Receipts are immutable
    }
  }
}
